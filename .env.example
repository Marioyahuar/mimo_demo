# Connection strings de Neon (Console > Connect). Usa una rama de desarrollo, nunca production.
# DATABASE_URL: pooled (host con "-pooler"); lo usa la app en runtime via @prisma/adapter-neon.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# DATABASE_URL_UNPOOLED: conexion directa (sin "-pooler"); la usa Prisma CLI para migraciones.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Setup: cp .env.example .env  ->  npm install (corre prisma generate)
#        npx prisma migrate deploy   (aplica migraciones en tu rama)

# --- Admin (/admin, ADR-0008) ---
# ADMIN_PASSWORD: clave unica del dueno. Si falta, el login responde 500 (cerrado por defecto).
ADMIN_PASSWORD="cambia-esta-clave"
# ADMIN_SESSION_SECRET: secreto de firma de la cookie, DISTINTO de la clave. Generar: openssl rand -hex 32
ADMIN_SESSION_SECRET="genera-un-secreto-largo-aleatorio"
# ADMIN_SESSION_TTL_HOURS: duracion de la sesion en horas (opcional, default 168 = 7 dias).
ADMIN_SESSION_TTL_HOURS="168"

# --- WhatsApp (boton de reenvio en la confirmacion, PRD "Alcance") ---
# NEXT_PUBLIC_WHATSAPP_NUMBER: numero de WhatsApp del spa, solo digitos con codigo de pais (ej. 51999999999).
# Valor real configurado en .env.local y Vercel; si falta, el boton no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
